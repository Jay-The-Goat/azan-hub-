local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer

local RANGE = 35
local WEAPONS = { ["Axe"] = true, ["Energy Sword"] = true, ["Staff"] = true, ["Fist"] = true }
local PARTS = { "HumanoidRootPart", "Head", "UpperTorso", "Torso" }

local fireTouch = firetouchinterest or fire_touch_interest or (syn and syn.firetouchinterest)
local enabled = false
local lastTick = 0

if getgenv().SPT_Aura_Connection then
    getgenv().SPT_Aura_Connection:Disconnect()
end

local function getWeapon(char)
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") and WEAPONS[v.Name] then
            local handle = v:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then return v, handle end
            for _, d in ipairs(v:GetDescendants()) do
                if d:IsA("TouchTransmitter") and d.Parent and d.Parent:IsA("BasePart") then
                    return v, d.Parent
                end
            end
        end
    end
end

local function hitTarget(tool, handle, target)
    local remote = tool:FindFirstChildOfClass("RemoteEvent") or tool:FindFirstChild("FightEvent")
    if remote then
        remote:FireServer()
        remote:FireServer()
    end

    for _, name in ipairs(PARTS) do
        local part = target:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            for _ = 1, 3 do
                fireTouch(handle, part, 0)
                fireTouch(handle, part, 1)
            end
        end
    end
end

getgenv().SPT_Aura_Connection = RunService.Heartbeat:Connect(function()
    if not enabled or not fireTouch then return end
    if os.clock() - lastTick < 0.033 then return end
    lastTick = os.clock()

    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local tool, handle = getWeapon(char)
    if not tool or not handle then return end

    tool:Activate()
    local pos = root.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp and (hrp.Position - pos).Magnitude <= RANGE then
                hitTarget(tool, handle, p.Character)
            end
        end
    end
end)

local gui = Instance.new("ScreenGui")
gui.Name = "SPT_3XAuraGui"
gui.ResetOnSpawn = false
gui.Parent = lp:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.fromOffset(150, 42)
btn.Position = UDim2.new(0.5, 0, 0, 15)
btn.AnchorPoint = Vector2.new(0.5, 0)
btn.Text = "3X DAMAGE: OFF"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 13
btn.AutoButtonColor = false
btn.BackgroundColor3 = Color3.fromRGB(20, 8, 8)
btn.TextColor3 = Color3.fromRGB(255, 180, 180)

Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
local stroke = Instance.new("UIStroke", btn)
stroke.Color = Color3.fromRGB(200, 40, 40)
stroke.Thickness = 1.6

btn.MouseButton1Click:Connect(function()
    enabled = not enabled
    btn.Text = enabled and "3X DAMAGE: ON" or "3X DAMAGE: OFF"
    btn.BackgroundColor3 = enabled and Color3.fromRGB(180, 20, 20) or Color3.fromRGB(20, 8, 8)
    btn.TextColor3 = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 180, 180)
    stroke.Color = enabled and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(200, 40, 40)
end)